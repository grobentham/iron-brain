//@version=6
// Iron Brain · Opening-range breakout v2 (tested on NQ and gold, fitted to a MyFundedFutures 50K Builder)
// Rules, all New York time:
//   1. The 09:00-10:00 high and low are the opening range.
//   2. From 10:00, a buy stop one tick above the high and a sell stop one tick below the low; one cancels the other.
//   3. v2: unfilled orders are cancelled at 12:00; stop at the far side of the range.
//      v1 (original): orders stay until 16:00; stop at the middle of the range.
//   4. One trade a day. Flat at 16:00 (the account is flattened at 16:10).
// Size: risk per trade / (stop distance x point value), capped at the account limit (40 micros or 4 minis).
// Use a 1- to 5-minute chart for the most faithful fills; 15 minutes also works. Not advice.
strategy("Iron Brain · Opening-range breakout v2", shorttitle = "IB ORB v2", overlay = true,
     initial_capital = 50000, currency = currency.USD, pyramiding = 0,
     default_qty_type = strategy.fixed, default_qty_value = 1,
     commission_type = strategy.commission.cash_per_contract, commission_value = 0.62,
     slippage = 1, use_bar_magnifier = true, process_orders_on_close = false, max_bars_back = 500)

// ---------- inputs ----------
string TZ      = "America/New_York"
string version = input.string("v2", "Version", options = ["v2", "v1 (original)"])
float  riskUsd = input.float(500, "Risk per trade ($)", minval = 1, step = 50)
int    maxQty  = input.int(40, "Max contracts (40 micros or 4 minis)", minval = 1)
int    tickPad = input.int(1, "Ticks beyond the range for the stop orders", minval = 0)
bool   longs   = input.bool(true, "Take long breakouts")
bool   shorts  = input.bool(true, "Take short breakouts")
bool   showTbl = input.bool(true, "Show today's levels")

bool  isV2      = version == "v2"
int   RANGE_END = 10 * 60                      // 10:00
int   ENTRY_END = isV2 ? 12 * 60 : 16 * 60     // v2 cancels unfilled orders at 12:00
int   FLAT_AT   = 16 * 60                      // 16:00
int   REOPEN    = 18 * 60                      // the futures day restarts at 18:00

// ---------- New York clock ----------
int   nyDate   = year(time, TZ) * 10000 + month(time, TZ) * 100 + dayofmonth(time, TZ)
bool  newDay   = nyDate != nyDate[1]
int   openMin  = hour(time, TZ) * 60 + minute(time, TZ)              // when this bar opened
int   closeMin = hour(time_close, TZ) * 60 + minute(time_close, TZ)  // when this bar closes
bool  inRange  = openMin >= 9 * 60 and openMin < RANGE_END

// ---------- state for the day ----------
var float orHi   = na
var float orLo   = na
var bool  ready  = false
var bool  traded = false
var bool  closed = false

if newDay
    orHi   := na
    orLo   := na
    ready  := false
    traded := false
    closed := false

if inRange
    orHi := na(orHi) ? high : math.max(orHi, high)
    orLo := na(orLo) ? low  : math.min(orLo, low)

// the range is final at the close of the bar that ends at 10:00
if closeMin == RANGE_END and not na(orHi) and orHi > orLo
    ready := true

if strategy.position_size != 0
    traded := true

// ---------- orders ----------
float pad      = tickPad * syminfo.mintick
float buyStop  = orHi + pad
float sellStop = orLo - pad
float mid      = (orHi + orLo) / 2
float stopL    = isV2 ? orLo : mid
float stopS    = isV2 ? orHi : mid
float riskPts  = buyStop - stopL                 // the same distance on both sides
int   qty      = ready ? int(math.min(maxQty, math.floor(riskUsd / (riskPts * syminfo.pointvalue)))) : 0

bool window = ready and not traded and closeMin >= RANGE_END and closeMin < ENTRY_END
if window and strategy.position_size == 0 and qty >= 1
    if longs
        strategy.entry("Long", strategy.long, qty = qty, stop = buyStop, oca_name = "ORB", oca_type = strategy.oca.cancel,
             alert_message = "ORB long filled: " + str.tostring(qty) + " at " + str.tostring(buyStop, format.mintick) + ", stop " + str.tostring(stopL, format.mintick))
    if shorts
        strategy.entry("Short", strategy.short, qty = qty, stop = sellStop, oca_name = "ORB", oca_type = strategy.oca.cancel,
             alert_message = "ORB short filled: " + str.tostring(qty) + " at " + str.tostring(sellStop, format.mintick) + ", stop " + str.tostring(stopS, format.mintick))

// protective stops for whichever side fills
strategy.exit("Long stop", from_entry = "Long", stop = stopL, comment = "Stop")
strategy.exit("Short stop", from_entry = "Short", stop = stopS, comment = "Stop")

// cancel unfilled orders when the entry window ends
if ready and closeMin >= ENTRY_END and closeMin < REOPEN
    strategy.cancel("Long")
    strategy.cancel("Short")

// flat at 16:00, at the close of the bar that ends then
if not closed and closeMin >= FLAT_AT and closeMin < REOPEN
    strategy.cancel_all()
    if strategy.position_size != 0
        strategy.close_all(comment = "16:00 flat", immediately = true)
    closed := true

// ---------- alerts ----------
// "Any alert() function call" alerts: the orders to place once the range is final
if ready and closeMin == RANGE_END and qty >= 1
    alert(syminfo.ticker + " ORB " + version + ": buy stop " + str.tostring(buyStop, format.mintick) + " (stop " + str.tostring(stopL, format.mintick) +
         "), sell stop " + str.tostring(sellStop, format.mintick) + " (stop " + str.tostring(stopS, format.mintick) + "), " + str.tostring(qty) +
         " contracts, cancel at " + (isV2 ? "12:00" : "16:00") + ", flat 16:00 NY", alert.freq_once_per_bar_close)
if ready and closeMin == RANGE_END and qty < 1
    alert(syminfo.ticker + " ORB " + version + ": range too wide for the risk setting, no trade today", alert.freq_once_per_bar_close)

// ---------- drawing ----------
bool showLevels = not na(orHi) and openMin >= 9 * 60 and openMin < FLAT_AT
plot(showLevels ? orHi : na, "Range high", color = color.new(#1e8a5a, 0), style = plot.style_linebr, linewidth = 2)
plot(showLevels ? orLo : na, "Range low", color = color.new(#c23b3b, 0), style = plot.style_linebr, linewidth = 2)
plot(showLevels and not isV2 ? mid : na, "Range middle (v1 stop)", color = color.new(color.gray, 30), style = plot.style_linebr)
bgcolor(inRange ? color.new(#e9a20c, 88) : na, title = "Opening range 09:00-10:00")
bgcolor(ready and closeMin > RANGE_END and closeMin <= ENTRY_END and not traded ? color.new(#2446c9, 93) : na, title = "Orders working")

var table tbl = table.new(position.top_right, 2, 6, bgcolor = color.new(color.white, 10), border_width = 1, border_color = color.new(color.gray, 70))
if showTbl and barstate.islast
    table.cell(tbl, 0, 0, "IB ORB " + version, text_color = color.black, text_size = size.small)
    table.cell(tbl, 1, 0, ready ? "range set" : "waiting for 10:00", text_color = color.gray, text_size = size.small)
    table.cell(tbl, 0, 1, "Buy stop", text_size = size.small)
    table.cell(tbl, 1, 1, ready ? str.tostring(buyStop, format.mintick) : "-", text_size = size.small)
    table.cell(tbl, 0, 2, "Sell stop", text_size = size.small)
    table.cell(tbl, 1, 2, ready ? str.tostring(sellStop, format.mintick) : "-", text_size = size.small)
    table.cell(tbl, 0, 3, "Protective stop", text_size = size.small)
    table.cell(tbl, 1, 3, ready ? (isV2 ? "far side" : "middle") + " · " + str.tostring(riskPts, format.mintick) + " pts" : "-", text_size = size.small)
    table.cell(tbl, 0, 4, "Size at $" + str.tostring(riskUsd), text_size = size.small)
    table.cell(tbl, 1, 4, ready ? str.tostring(qty) + " contracts" : "-", text_size = size.small)
    table.cell(tbl, 0, 5, "Cancel / flat", text_size = size.small)
    table.cell(tbl, 1, 5, (isV2 ? "12:00" : "16:00") + " / 16:00 NY", text_size = size.small)
