{
  "manifest_version": 3,
  "name": "ICT Brain Live Bridge",
  "version": "1.2.1",
  "description": "Five-chart TradingView monitoring through the local deterministic ICT Brain engine with no external model APIs.",
  "permissions": [
    "storage",
    "tabs",
    "alarms",
    "notifications",
    "scripting"
  ],
  "host_permissions": [
    "https://www.tradingview.com/*",
    "http://127.0.0.1:8787/*",
    "http://localhost:8787/*"
  ],
  "background": {
    "service_worker": "service-worker-local.js",
    "type": "module"
  },
  "action": {
    "default_title": "ICT Brain Live Bridge",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://www.tradingview.com/*"],
      "js": ["content-script.js"],
      "run_at": "document_idle"
    }
  ]
}
