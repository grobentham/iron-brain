{
  "manifest_version": 3,
  "name": "Iron Brain Live Bridge",
  "version": "2.0.0",
  "description": "Reads the symbol and last price from your TradingView tab titles and passes them to the Iron Brain intraday desk.",
  "permissions": ["tabs"],
  "host_permissions": ["https://www.tradingview.com/*"],
  "background": { "service_worker": "service-worker.js" },
  "content_scripts": [
    { "matches": ["https://grobentham.github.io/iron-brain/*"], "js": ["page-bridge.js"], "run_at": "document_idle" }
  ],
  "icons": { "128": "icon.png" }
}
